{
  "id": "understand-system-state",
  "extension": "system-state-agent",
  "summary": "Produce general and User Request-focused system-state understanding before Design owns governed requirements or scope.",
  "lifecycle_stage": "understand_system_state",
  "entrypoints": {
    "default": "entrypoints/default.md"
  },
  "activation": {
    "default": "conditional",
    "triggers": [
      "any governed software work is requested"
    ]
  },
  "requires_artifacts": [
    "_hirmos/session/SESSION_SCOPE.md parent authority"
  ],
  "produces_artifacts": [
    "_hirmos/session/DESIGN.md current-state basis",
    "_hirmos/session/unresolved-items.md",
    "_hirmos/session/SESSION_LEDGER.md"
  ],
  "execution_controls": [
    "system-state control",
    "working-copy control",
    "unresolved-item control when needed"
  ],
  "unresolved_items": {
    "producer": true,
    "required_when_material": true
  }
}
