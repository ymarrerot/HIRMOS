{
  "id": "delivery-design",
  "extension": "design-agent",
  "summary": "Select and maintain durable delivery routing by appending/updating the delivery roadmap/register and one delivery scope when multi-session governance is required.",
  "lifecycle_stage": "design",
  "entrypoints": {
    "default": "entrypoints/default.md"
  },
  "activation": {
    "default": "conditional",
    "triggers": [
      "Delivery Shape Decision selects a durable delivery shape",
      "Delivery Shape Decision selects MULTI_SESSION_DELIVERY",
      "Delivery Shape Decision selects MULTI_SESSION_DELIVERY_WITH_PHASE_FILES",
      "durable multi-session work in any project context cannot be safely governed as one session",
      "existing durable delivery roadmap/register must be appended or reconciled",
      "Current System State delivery pointers indicate active delivery governance"
    ]
  },
  "requires_artifacts": [
    "_hirmos/session/SESSION_EXECUTION.md",
    "_hirmos/session/SESSION_SCOPE.md when available",
    "_hirmos/session/unresolved-items.md",
    "_hirmos/system/accepted-state/CURRENT_SYSTEM_STATE.md when present"
  ],
  "produces_artifacts": [
    "_hirmos/system/delivery/DELIVERY_PLAN.md",
    "_hirmos/system/delivery/<delivery-id>/DELIVERY_SCOPE.md",
    "_hirmos/session/SESSION_EXECUTION.md",
    "_hirmos/session/unresolved-items.md when delivery blockers are found"
  ],
  "execution_controls": [
    "Delivery Shape Decision Gate",
    "delivery-route control",
    "durable-delivery-roadmap control",
    "delivery-scope authority control",
    "unresolved-item control when needed"
  ],
  "unresolved_items": {
    "producer": true,
    "required_when_material": true
  }
}
