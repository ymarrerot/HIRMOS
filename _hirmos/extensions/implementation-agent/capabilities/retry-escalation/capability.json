{
  "id": "retry-escalation",
  "extension": "implementation-agent",
  "summary": "Govern failed implementation or validation attempts and decide whether retry is safe inside current scope.",
  "lifecycle_stage": "implementation",
  "entrypoints": {
    "default": "entrypoints/default.md"
  },
  "activation": {
    "default": "conditional",
    "triggers": [
      "implementation attempt failed",
      "validation failed",
      "retry decision is needed"
    ]
  },
  "requires_artifacts": [
    "_hirmos/session/SESSION_SCOPE.md",
    "_hirmos/session/unresolved-items.md",
    "failed/partial/blocked _hirmos/session/implementation-units/IU-<unit-id>.md"
  ],
  "produces_artifacts": [
    "_hirmos/session/implementation-units/IU-<unit-id>.md",
    "_hirmos/session/unresolved-items.md",
    "_hirmos/session/SESSION_EXECUTION.md"
  ],
  "execution_controls": [
    "retry/escalation control",
    "unresolved-item control when needed"
  ],
  "unresolved_items": {
    "producer": true,
    "required_when_material": true
  }
}
